{
  "schema_version": 1,
  "id": "reexport.break_intermediate_chain",
  "family": "reexport_reachability",
  "description": "An intermediate facade stops re-exporting Core while the top-level provider remains textually unchanged.",
  "language_rules": ["module.import", "module.reach"],
  "mutation": "Change Facade's export import Core to a private import.",
  "primary_module": "Provider",
  "tracked_modules": ["Core", "Facade", "Provider"],
  "observation": { "kind": "name_reachability", "probe_id": null },
  "states": {
    "before": {
      "modules": [
        { "name": "Core", "source": "before/core.cppm", "imports": [] },
        { "name": "Facade", "source": "before/facade.cppm", "imports": ["Core"] },
        { "name": "Provider", "source": "before/provider.cppm", "imports": ["Facade"] }
      ],
      "consumer": "before/consumer.cpp"
    },
    "after": {
      "modules": [
        { "name": "Core", "source": "after/core.cppm", "imports": [] },
        { "name": "Facade", "source": "after/facade.cppm", "imports": ["Core"] },
        { "name": "Provider", "source": "after/provider.cppm", "imports": ["Facade"] }
      ],
      "consumer": "after/consumer.cpp"
    }
  }
}

