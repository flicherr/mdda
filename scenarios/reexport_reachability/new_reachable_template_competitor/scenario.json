{
  "schema_version": 1,
  "id": "reexport.new_reachable_candidate",
  "family": "reexport_reachability",
  "description": "A newly re-exported non-template function competes with and replaces the previously selected generic template.",
  "language_rules": ["module.import", "basic.lookup.general", "over.match.best.general"],
  "mutation": "Re-export Base, making its non-template score overload reachable.",
  "primary_module": "Provider",
  "tracked_modules": ["Base", "Provider"],
  "observation": { "kind": "selected_declaration", "probe_id": "result" },
  "states": {
    "before": {
      "modules": [
        { "name": "Base", "source": "before/base.cppm", "imports": [] },
        { "name": "Provider", "source": "before/provider.cppm", "imports": ["Base"] }
      ],
      "consumer": "before/consumer.cpp"
    },
    "after": {
      "modules": [
        { "name": "Base", "source": "after/base.cppm", "imports": [] },
        { "name": "Provider", "source": "after/provider.cppm", "imports": ["Base"] }
      ],
      "consumer": "after/consumer.cpp"
    }
  }
}

