{
  "schema_version": 1,
  "id": "reexport.remove_export_import",
  "family": "reexport_reachability",
  "description": "Removing re-export reachability makes an unchanged consumer name lookup fail although the used Base declaration is unchanged.",
  "language_rules": ["module.import", "module.reach", "basic.lookup.general"],
  "mutation": "Change export import Base to a private import.",
  "primary_module": "Provider",
  "tracked_modules": ["Base", "Provider"],
  "observation": { "kind": "name_reachability", "probe_id": null },
  "states": {
    "before": {
      "modules": [
        { "name": "Base", "source": "before/base.cppm", "imports": [] },
        { "name": "Provider", "source": "before/provider.cppm", "imports": ["Base"] }
      ],
      "consumer": "before/consumer.cpp"
    },
    "after": {
      "modules": [
        { "name": "Base", "source": "after/base.cppm", "imports": [] },
        { "name": "Provider", "source": "after/provider.cppm", "imports": ["Base"] }
      ],
      "consumer": "after/consumer.cpp"
    }
  }
}

